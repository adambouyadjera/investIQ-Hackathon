# --- Data snapshots ---
# prices.csv is regenerated by: python scripts/fetch_data.py
# Keeping market data out of git avoids a large, churning binary-ish file
# and any question about redistributing vendor data.
data/*.csv
data/*.parquet
!data/.gitkeep

