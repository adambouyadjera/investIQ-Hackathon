# Copy to backend/.env and fill in. Never commit the real file.

# Local dev (SQLite, no setup). Docker/production uses Postgres.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional. Absent = deterministic demo explanations, clearly labelled in the UI.
ANTHROPIC_API_KEY=

# Optional quote providers. Blank = yfinance only.
POLYGON_KEY=
ALPHA_VANTAGE_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
